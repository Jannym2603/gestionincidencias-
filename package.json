{
  "name": "gestionincidencias",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de Gestión de Incidencias con API NestJS, frontend Astro y PostgreSQL.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "api": "npm run start:dev --prefix apps/api",
    "web": "npm run dev --prefix apps/web",
    "build": "npm run build:api && npm run build:web",
    "build:api": "npm run build --prefix apps/api",
    "build:web": "npm run build --prefix apps/web",
    "check": "npm run check --prefix apps/web",
    "typecheck:api": "npx --prefix apps/api tsc --noEmit -p apps/api/tsconfig.json",
    "test:api": "npm run test --prefix apps/api",
    "test:api:e2e": "npm run test:e2e --prefix apps/api",
    "test:web:e2e": "npm run build:api && npm run test:e2e --prefix apps/web",
    "test:legacy:e2e": "playwright test",
    "test": "npm run test:api && npm run test:api:e2e && npm run test:web:e2e",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
