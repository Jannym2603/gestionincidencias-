---
import App from '../layouts/App.astro';
import '../styles/admin.css';
---
<App active="companias-proyectos" title="Compañías" description="Administra compañías y consulta sus proyectos.">
    <p id="admin-access-denied" class="admin-access-denied" role="alert" hidden></p>
    <section id="admin-content" data-admin-view="list" hidden>
        <section class="action-bar"><div><h2>Compañías registradas</h2><p>Desde cada compañía puedes revisar sus proyectos y administrar su estado.</p></div><div class="admin-toolbar-actions"><button id="companies-reload" class="secondary-btn" type="button">Actualizar datos</button><a id="company-create-link" class="primary-btn" href="/companias/nueva" hidden>Nueva compañía</a></div></section>
        <p id="companies-status" class="feedback admin-feedback" role="status">Cargando compañías…</p>
        <div id="companies-list" class="company-management-grid"><p>Cargando compañías…</p></div>
    </section>
</App>
<script src="../lib/companies.ts"></script>
