---
import App from '../../layouts/App.astro';
import CompanyEditor from '../../components/CompanyEditor.astro';
import '../../styles/admin.css';
const { id } = Astro.params;
---
<App active="companias-proyectos" title="Detalle de compañía" description="Datos y proyectos asociados.">
    <p id="admin-access-denied" class="admin-access-denied" role="alert" hidden></p>
    <section id="admin-content" data-admin-view="detail" data-record-id={id} hidden>
        <a class="admin-back-link" href="/companias">← Compañías</a>
        <p id="company-detail-status" class="feedback admin-feedback" role="status">Cargando compañía…</p>
        <section class="table-section"><div class="section-header"><div><h2 id="company-detail-title">Compañía</h2><p id="company-detail-description"></p></div><div class="admin-toolbar-actions"><button id="company-edit-toggle" class="secondary-btn" type="button" hidden>Editar</button><button id="company-state-toggle" class="secondary-btn" type="button" hidden>Desactivar</button></div></div><dl id="company-detail-fields" class="admin-detail-grid"></dl></section>
        <section id="company-edit-section" class="table-section admin-form-section" hidden><div class="section-header"><div><h2>Editar compañía</h2></div></div><CompanyEditor /></section>
        <section class="table-section admin-form-section"><div class="section-header"><div><h2>Proyectos asociados</h2><p>Consulta los proyectos de esta compañía.</p></div></div><p id="company-projects-status" class="feedback admin-feedback" role="status">Cargando proyectos…</p><div id="company-projects-list" class="admin-project-list"></div></section>
    </section>
</App>
<script src="../../lib/companies.ts"></script>
