---
import App from '../layouts/App.astro';
import '../styles/admin.css';
---
<App active="proyectos" title="Proyectos" description="Proyectos disponibles según tu acceso.">
    <p id="admin-access-denied" class="admin-access-denied" role="alert" hidden></p>
    <section id="admin-content" data-admin-view="list" hidden>
        <section class="action-bar"><div><h2>Proyectos</h2><p id="projects-description">Consulta los proyectos disponibles según tus permisos.</p></div><div class="admin-toolbar-actions"><button id="projects-reload" class="secondary-btn" type="button">Actualizar</button><a id="project-create-link" class="primary-btn" href="/proyectos/nuevo" hidden>Nuevo proyecto</a></div></section>
        <p id="projects-status" class="feedback admin-feedback" role="status">Cargando proyectos…</p>
        <section class="admin-toolbar"><div class="admin-filters"><div class="form-group"><label for="project-search">Buscar proyecto</label><input id="project-search" type="search" placeholder="Nombre o compañía" /></div><div class="form-group"><label for="project-filter-state">Estado</label><select id="project-filter-state"><option value="">Todos</option><option value="true">Activos</option><option value="false">Inactivos</option></select></div></div></section>
        <section class="table-section"><div class="table-wrapper"><table><thead><tr><th>Proyecto</th><th>Compañía</th><th>Descripción</th><th>Estado</th><th>Acciones</th></tr></thead><tbody id="projects-body"><tr><td colspan="5">Cargando proyectos…</td></tr></tbody></table></div><p id="projects-count" class="table-count"></p></section>
    </section>
</App>
<script src="../lib/projects.ts"></script>
