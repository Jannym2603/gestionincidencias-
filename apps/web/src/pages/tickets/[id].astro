---
import App from '../../layouts/App.astro';
import '../../styles/ticket-actions.css';
---
<App active="tickets">
<div class="ticket-detail-heading"><a class="ticket-back-button" href="/tickets">&larr; Volver a tickets</a><p id="detail-status" class="feedback" role="status">Cargando ticket...</p><div id="ticket-content" hidden>
<section class="table-section detail-summary"><div class="section-header"><div><span class="ticket-number" id="ticket-number"></span><h2 id="ticket-title"></h2><p id="ticket-description"></p></div><div class="ticket-badges"><span class="badge" id="ticket-state"></span><span class="badge" id="ticket-priority"></span><span class="badge" id="ticket-attention"></span></div></div><dl class="ticket-facts"><div><dt>Tipo</dt><dd id="ticket-type"></dd></div><div><dt>Cliente</dt><dd id="ticket-client"></dd></div><div><dt>Agente</dt><dd id="ticket-agent"></dd></div><div><dt>Compania</dt><dd id="ticket-company"></dd></div><div><dt>Proyecto</dt><dd id="ticket-project"></dd></div><div><dt>Fecha de creacion</dt><dd id="ticket-created"></dd></div><div><dt>Actualizado</dt><dd id="ticket-updated"></dd></div><div><dt>Cierre</dt><dd id="ticket-closed"></dd></div><div><dt>Primera respuesta / SLA</dt><dd id="ticket-response-sla"></dd></div><div><dt>Resolucion / SLA</dt><dd id="ticket-resolution-sla"></dd></div><div><dt>Tiempo abierto</dt><dd id="ticket-open-time"></dd></div></dl></section>
<section class="table-section detail-section" id="ticket-actions" hidden><div class="section-header"><div><h2>Acciones del ticket</h2><p>Las opciones disponibles dependen de tu rol y del estado actual.</p></div></div><p id="action-status" role="status"></p><div class="ticket-action-grid"><form id="assignment-form" hidden><h3>Asignar agente</h3><label for="agent-select">Agente del proyecto</label><select id="agent-select" required></select><button id="assign-submit" class="secondary-btn" type="submit">Asignar agente</button></form><form id="state-form" hidden><h3>Cambiar estado</h3><label for="state-select">Siguiente estado</label><select id="state-select" required></select><label for="close-note">Nota de cierre</label><textarea id="close-note" rows="2" maxlength="2000"></textarea><button id="state-submit" class="secondary-btn" type="submit">Actualizar estado</button></form><form id="priority-form" hidden><h3>Ajustar prioridad</h3><label for="priority-select">Prioridad</label><select id="priority-select"><option value="P1_CRITICA">P1 Critica</option><option value="P2_ALTA">P2 Alta</option><option value="P3_MEDIA">P3 Media</option><option value="P4_BAJA">P4 Baja</option></select><label for="priority-note">Justificacion opcional</label><input id="priority-note" maxlength="500" /><button id="priority-submit" class="secondary-btn" type="submit">Guardar prioridad</button></form></div></section>
<section class="table-section detail-section" id="resource-section" hidden><div class="section-header"><div><h2>Recurso externo</h2><p>Seguimiento de proveedor asociado al ticket.</p></div></div><dl class="ticket-facts"><div><dt>Recurso</dt><dd id="resource-name"></dd></div><div><dt>Proveedor</dt><dd id="resource-provider"></dd></div><div><dt>Estado</dt><dd id="resource-state"></dd></div><div><dt>Entrega estimada</dt><dd id="resource-delivery"></dd></div><div><dt>Situacion</dt><dd id="resource-delay"></dd></div><div><dt>Dias de retraso</dt><dd id="resource-delay-days"></dd></div></dl><p id="resource-status" role="status"></p><form id="resource-form" class="ticket-form" hidden><h3>Actualizar solicitud de recurso</h3><div class="form-grid"><div class="form-group"><label for="resource-provider-input">Proveedor</label><input id="resource-provider-input" maxlength="150" /></div><div class="form-group"><label for="resource-state-select">Siguiente estado</label><select id="resource-state-select"></select></div><div class="form-group"><label for="resource-request-date">Fecha de solicitud al proveedor</label><input id="resource-request-date" type="datetime-local" /></div><div class="form-group"><label for="resource-estimated-date">Fecha estimada</label><input id="resource-estimated-date" type="datetime-local" /></div><div class="form-group"><label for="resource-received-date">Fecha de recepcion</label><input id="resource-received-date" type="datetime-local" /></div><div class="form-group"><label for="resource-delivered-date">Fecha de entrega al cliente</label><input id="resource-delivered-date" type="datetime-local" /></div><div class="form-group"><label for="resource-delay-reason">Motivo del retraso</label><input id="resource-delay-reason" maxlength="100" /></div><div class="form-group"><label for="resource-delay-detail">Detalle del retraso</label><textarea id="resource-delay-detail" rows="2"></textarea></div><div class="form-group"><label for="resource-observations">Observaciones</label><textarea id="resource-observations" rows="2"></textarea></div></div><button id="resource-submit" class="secondary-btn" type="submit">Guardar seguimiento</button></form></section>
<section class="table-section detail-section"><div class="section-header"><div><h2>Comentarios</h2><p>Seguimiento visible segun los permisos de tu rol.</p></div></div><form id="comment-form" class="comment-form"><div class="form-group"><label for="comment-visibility">Visibilidad</label><select id="comment-visibility"><option value="PUBLICO">Publico</option><option value="INTERNO">Interno</option></select></div><div class="form-group"><label for="comment-content">Comentario</label><textarea id="comment-content" rows="3" maxlength="5000" required placeholder="Escribe un comentario..."></textarea></div><p id="comment-status" role="status"></p><button type="submit" class="primary-btn" id="comment-submit">Agregar comentario</button></form><div class="ticket-comments" id="comments-list"><p>Cargando comentarios...</p></div></section>
<section class="table-section detail-section" id="history-section"><div class="section-header"><div><h2>Historial</h2><p>Actividad del ticket, mas reciente primero.</p></div></div><p id="history-status" role="status">Cargando historial...</p><div id="history-list" class="ticket-history"></div></section>
<section class="table-section detail-section"><div class="section-header"><div><h2>Archivos adjuntos</h2><p>Sube o descarga archivos del ticket. Maximo 10 MB por archivo.</p></div></div><form id="upload-form" class="upload-form"><div class="form-group"><label for="attachment">Seleccionar archivo</label><input type="file" id="attachment" accept=".pdf,.doc,.docx,.png,.jpg,.jpeg,.txt,.xls,.xlsx" required /></div><button type="submit" class="secondary-btn" id="upload-submit">Subir archivo</button></form><p id="attachment-status" role="status"></p><div class="table-wrapper"><table><thead><tr><th>Archivo</th><th>Tipo</th><th>Tamano</th><th>Fecha</th><th>Accion</th></tr></thead><tbody id="attachments-list"><tr><td colspan="5">Cargando adjuntos...</td></tr></tbody></table></div></section>
</div></div>
</App>
<script src="../../lib/ticket-detail.ts"></script>
