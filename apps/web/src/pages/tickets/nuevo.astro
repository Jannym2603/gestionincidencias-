---
import App from '../../layouts/App.astro';
import '../../styles/ticket-actions.css';
---
<App active="crear-ticket"><section class="ticket-detail-heading"><a class="ticket-back-button" href="/tickets">&larr; Volver a tickets</a><div class="table-section"><div class="section-header"><div><h2>Crear ticket</h2><p>Registra una incidencia en un proyecto autorizado.</p></div></div><p id="create-status" class="feedback" role="status"></p><form id="create-ticket-form" class="ticket-form"><div class="form-grid"><div class="form-group"><label for="attention">Tipo de atencion</label><select id="attention"><option value="OPERATIVO">Operativo</option><option value="RECURSO_EXTERNO">Recurso externo</option></select></div><div class="form-group"><label for="project">Proyecto *</label><select id="project" required><option value="">Cargando proyectos...</option></select></div><div class="form-group" id="customer-wrap"><label for="customer">Cliente *</label><select id="customer" required><option value="">Selecciona cliente</option></select></div><div class="form-group"><label for="incident-type">Tipo de incidencia *</label><select id="incident-type" required><option value="">Cargando tipos...</option></select></div><div class="form-group" id="title-wrap"><label for="title">Asunto / titulo *</label><input id="title" maxlength="150" required /></div><div class="form-group"><label for="severity">Severidad</label><select id="severity"><option value="BAJA">Baja</option><option value="MEDIA" selected>Media</option><option value="ALTA">Alta</option><option value="CRITICA">Critica</option></select></div><div class="form-group"><label for="criticality">Criticidad</label><select id="criticality"><option value="BAJA">Baja</option><option value="MEDIA" selected>Media</option><option value="ALTA">Alta</option><option value="CRITICA">Critica</option></select></div><div class="form-group"><label for="impact">Impacto *</label><select id="impact" required><option value="BAJO">Bajo</option><option value="MEDIO" selected>Medio</option><option value="ALTO">Alto</option></select></div><div class="form-group"><label for="urgency">Urgencia *</label><select id="urgency" required><option value="BAJA">Baja</option><option value="MEDIA" selected>Media</option><option value="ALTA">Alta</option></select></div></div><div class="form-group"><label for="description">Descripcion *</label><textarea id="description" rows="5" required maxlength="10000"></textarea></div><fieldset id="resource-fields" hidden><legend>Solicitud de recurso externo</legend><div class="form-grid"><div class="form-group"><label for="resource-category">Categoria *</label><select id="resource-category"><option value="PIEZA_COMPUTADORA">Pieza de computadora</option><option value="ALARMA">Alarma</option><option value="CAMARA">Camara</option><option value="EQUIPO">Equipo</option><option value="OTRO">Otro</option></select></div><div class="form-group"><label for="resource-name">Recurso solicitado *</label><input id="resource-name" maxlength="150" /></div><div class="form-group"><label for="resource-quantity">Cantidad *</label><input id="resource-quantity" type="number" min="1" step="1" value="1" /></div><div class="form-group"><label for="resource-notes">Observaciones</label><input id="resource-notes" /></div></div></fieldset><div class="form-group"><label for="ticket-file">Archivo opcional</label><input id="ticket-file" type="file" accept=".pdf,.doc,.docx,.png,.jpg,.jpeg,.txt,.xlsx,.xls" /><small>PDF, DOC/DOCX, PNG/JPG, TXT o XLS/XLSX. Maximo 10 MB.</small></div><div class="form-actions"><a class="secondary-btn" href="/tickets">Cancelar</a><button id="create-submit" class="primary-btn" type="submit">Crear ticket</button></div></form></div></section></App>
<script src="../../lib/create-ticket.ts"></script>
