---
import Base from '../layouts/Base.astro';
---
<Base title="Login" bodyClass="login-page"><div class="login-container"><div class="login-card"><div class="login-logo">GI</div><h1>Iniciar sesión</h1><p>Accede al sistema de gestión de incidencias con tus credenciales.</p>
<form id="loginForm"><label for="correo">Correo electrónico</label><input type="email" id="correo" name="correo" placeholder="correo@ejemplo.com" autocomplete="username" required /><label for="password">Contraseña</label><div class="password-wrapper"><input type="password" id="password" name="password" placeholder="Ingresa tu contraseña" autocomplete="current-password" required /><button type="button" class="password-toggle" id="toggle-password" aria-label="Mostrar contraseña" aria-pressed="false">👁</button></div><p id="login-error" class="feedback error" role="alert" hidden></p><button type="submit" id="login-submit">Entrar al sistema</button></form>
<p class="login-note">Los usuarios solo pueden ser creados por un administrador o supervisor.</p></div></div></Base>
<script src="../lib/login.ts"></script>
