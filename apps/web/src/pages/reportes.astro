---
import App from '../layouts/App.astro';
import '../styles/admin.css';
---
<App active="reportes" title="Reportes" description="Indicadores operativos y seguimiento de recursos externos.">
    <p id="reports-access-denied" class="admin-access-denied" role="alert" hidden></p>
    <p id="reports-status" class="feedback" role="status">Cargando alcance disponible…</p>
    <section id="reports-content" hidden>
        <section class="action-bar"><div><h2>Panel de reportes</h2><p>Las métricas operativas se calculan por separado de los recursos que dependen de proveedores.</p></div><button class="secondary-btn" id="reports-reload" type="button">Actualizar</button></section>
        <section class="form-card"><div class="section-header"><div><h2>Filtrar reporte</h2><p>El mismo alcance se aplica a Operaciones y Recursos Externos.</p></div><button class="secondary-btn" id="reports-clear" type="button">Limpiar filtros</button></div><div class="form-grid report-filter-grid"><div class="form-group"><label for="reports-company">Compañía</label><select id="reports-company"><option value="">Todas las compañías</option></select></div><div class="form-group"><label for="reports-project">Proyecto</label><select id="reports-project"><option value="">Todos los proyectos</option></select></div></div><p class="feedback" id="reports-scope">Mostrando: Resumen general</p></section>
        <p class="feedback" id="reports-data-status" role="status">Cargando reportes…</p>
        <section class="metrics-grid admin-summary-grid"><article class="metric-card"><span>Tickets incluidos</span><h3 id="report-total-tickets">—</h3><p>Según tu alcance de acceso</p></article><article class="metric-card blue"><span>Usuarios relacionados</span><h3 id="report-related-users">—</h3><p>Clientes y agentes en los tickets</p></article><article class="metric-card purple"><span>Comentarios visibles</span><h3 id="report-comments">—</h3><p>Se excluyen comentarios internos para CLIENTE</p></article></section>
        <section class="table-section"><div class="section-header"><div><h2>Operaciones</h2><p>Solo tickets operativos; la espera de proveedores no afecta estas métricas.</p></div></div><div class="metrics-grid"><article class="metric-card"><span>Tickets operativos</span><h3 id="report-operational-total">—</h3><p>Total incluido</p></article><article class="metric-card blue"><span>Nuevos</span><h3 id="report-new">—</h3><p>Pendientes de asignación</p></article><article class="metric-card purple"><span>En progreso</span><h3 id="report-progress">—</h3><p>Asignados, en progreso y resueltos</p></article><article class="metric-card green"><span>Cerrados</span><h3 id="report-closed">—</h3><p>Finalizados</p></article></div></section>
        <section class="reports-grid"><article class="report-card"><h3>Operativos por estado</h3><div id="report-states" class="report-list"></div></article><article class="report-card"><h3>Operativos por prioridad</h3><div id="report-priorities" class="report-list"></div></article><article class="report-card"><h3>Operativos por tipo</h3><div id="report-types" class="report-list"></div></article></section>
        <section class="table-section"><div class="section-header"><div><h2>Recursos externos</h2><p>Seguimiento independiente de solicitudes a proveedores.</p></div></div><div class="metrics-grid"><article class="metric-card"><span>Solicitudes</span><h3 id="resource-total">—</h3><p>Total de recursos</p></article><article class="metric-card orange"><span>Esperando proveedor</span><h3 id="resource-waiting">—</h3><p>Dependencia externa</p></article><article class="metric-card blue"><span>Recibidos</span><h3 id="resource-received">—</h3><p>Ya disponibles</p></article><article class="metric-card green"><span>Entregados</span><h3 id="resource-delivered">—</h3><p>Entregados al cliente</p></article><article class="metric-card"><span>Retrasados</span><h3 id="resource-late">—</h3><p>Fecha estimada vencida</p></article><article class="metric-card purple"><span>Promedio proveedor</span><h3 id="resource-days">—</h3><p>Días hasta recepción</p></article></div></section>
        <section class="reports-grid"><article class="report-card"><h3>Recursos por estado</h3><div id="resource-states" class="report-list"></div></article><article class="report-card"><h3>Seguimiento de entregas</h3><div id="resource-deliveries" class="report-list"></div></article><article class="report-card"><h3>Interpretación</h3><div class="report-list"><div class="report-item"><span>SLA operativo</span><strong>No incluye espera de proveedor</strong></div><div class="report-item"><span>Tiempo de proveedor</span><strong>Métrica independiente</strong></div></div></article></section>
        <section class="table-section"><div class="section-header"><div><h2 id="report-summary-title">Resumen del reporte</h2><p id="report-summary-description">Comparación entre trabajo operativo y recursos externos.</p></div><button class="secondary-btn" id="reports-print" type="button">Imprimir reporte</button></div><div class="table-wrapper"><table><thead><tr><th>Área</th><th>Indicador</th><th>Valor</th><th>Descripción</th></tr></thead><tbody id="report-summary-body"><tr><td colspan="4">Cargando resumen…</td></tr></tbody></table></div></section>
    </section>
</App>
<script src="../lib/reports.ts"></script>
