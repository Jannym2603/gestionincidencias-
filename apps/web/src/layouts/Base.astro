---
import '../styles/legacy.css';
import '../styles/web.css';
interface Props { title: string; bodyClass?: string }
const { title, bodyClass = '' } = Astro.props;
---
<!doctype html><html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex" /><title>{title} | Gestión de Incidencias</title><link rel="icon" href="/favicon.svg" /></head><body class={bodyClass}><slot /><noscript><p class="feedback">Activa JavaScript para iniciar sesión y consultar el sistema.</p></noscript></body></html>
