<section class="table-section ticket-filters"><div class="form-grid">
<div class="form-group"><label for="ticket-search">Buscar ticket</label><input id="ticket-search" type="search" placeholder="Número, título, cliente, compañía o proyecto…" /></div>
<div class="form-group"><label for="filter-company">Compañía</label><select id="filter-company"><option value="">Todas las compañías</option></select></div>
<div class="form-group"><label for="filter-project">Proyecto</label><select id="filter-project"><option value="">Todos los proyectos</option></select></div>
<div class="form-group"><label for="filter-kind">Tipo de incidencia</label><select id="filter-kind"><option value="">Todos</option></select></div>
<div class="form-group"><label for="filter-attention">Tipo de atención</label><select id="filter-attention"><option value="">Todos</option><option value="OPERATIVO">OPERATIVO</option><option value="RECURSO_EXTERNO">RECURSO EXTERNO</option></select></div>
<div class="form-group"><label for="filter-state">Estado</label><select id="filter-state"><option value="">Todos</option><option>NUEVO</option><option>ASIGNADO</option><option>EN_PROGRESO</option><option>RESUELTO</option><option>CERRADO</option></select></div>
<div class="form-group"><label for="filter-priority">Prioridad</label><select id="filter-priority"><option value="">Todas</option><option>P1_CRITICA</option><option>P2_ALTA</option><option>P3_MEDIA</option><option>P4_BAJA</option></select></div>
<div class="form-group" id="customer-filter-wrap" hidden><label for="filter-customer">Cliente</label><select id="filter-customer"><option value="">Todos</option></select></div>
</div></section>
