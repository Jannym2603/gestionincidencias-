# Copy to .env and replace placeholders locally. Never commit .env.
# This DATABASE_URL is illustrative only; use a dedicated local/demo database.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/gestionincidencias

# Generate a private random value with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-bytes
PORT=3000

# Shared ticket links point to the Astro frontend. The API falls back to :8081.
FRONTEND_URL=http://localhost:4321

# Optional Gmail SMTP. Leave both blank to disable email delivery.
MAIL_USERNAME=
MAIL_PASSWORD=
SUPPORT_EMAIL=
MAIL_COPY_SUPPORT=false

# Optional delayed resource notification job intervals in milliseconds.
APP_RECURSOS_RETRASOS_DELAY_INICIAL_MS=60000
APP_RECURSOS_RETRASOS_INTERVALO_MS=3600000
