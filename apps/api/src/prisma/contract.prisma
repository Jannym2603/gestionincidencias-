// use prisma-8
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

model Companias {
  id                 Int          @id(map: "companias_pkey") @default(autoincrement())
  descripcion        String?
  estado             Boolean
  fechaActualizacion Timestamp(6) @map("fecha_actualizacion")
  fechaCreacion      Timestamp(6) @map("fecha_creacion")
  nombre             VarChar(150) @unique(map: "uk_companias_nombre")
  proyectos          Proyectos[]

  @@map("companias")
}

model Proyectos {
  id                 Int                @id(map: "proyectos_pkey") @default(autoincrement())
  descripcion        String?
  estado             Boolean
  fechaActualizacion Timestamp(6)       @map("fecha_actualizacion")
  fechaCreacion      Timestamp(6)       @map("fecha_creacion")
  nombre             VarChar(150)
  companiaId         Int                @map("compania_id")
  tickets            Tickets[]
  usuarioProyectos   UsuarioProyectos[]
  compania           Companias          @relation(fields: [companiaId], references: [id], map: "fkf3oha5gagddmp7p8ke0fatffy")

  @@unique([companiaId, nombre], map: "uk_proyecto_compania_nombre")
  @@index([companiaId], map: "idx_proyecto_compania")
  @@map("proyectos")
}

model TiposIncidencia {
  id          Int          @id(map: "tipos_incidencia_pkey") @default(autoincrement())
  nombre      VarChar(100) @unique(map: "tipos_incidencia_nombre_key")
  descripcion String?
  estado      Boolean?     @default(true)
  tickets     Tickets[]

  @@map("tipos_incidencia")
}

model Usuarios {
  id                 Int                  @id(map: "usuarios_pkey") @default(autoincrement())
  nombre             VarChar(100)
  apellido           VarChar(100)
  correo             VarChar(150)         @unique(map: "usuarios_correo_key")
  password           VarChar(100)
  telefono           VarChar(20)?
  estado             Boolean?             @default(true)
  fechaCreacion      Timestamp?           @default(now()) @map("fecha_creacion")
  comentarios        Comentarios[]
  enlacesCompartidos EnlacesCompartidos[]
  historialTickets   HistorialTickets[]
  usuarioProyectos   UsuarioProyectos[]
  usuarioRoles       UsuarioRoles[]
  tickets            Tickets[]            @relation(name: "fk_ticket_agente")
  ticketsTickets     Tickets[]            @relation(name: "fk_ticket_cliente")

  @@map("usuarios")
}

model Tickets {
  id                    Int                  @id(map: "tickets_pkey") @default(autoincrement())
  numeroTicket          VarChar(30)          @unique(map: "tickets_numero_ticket_key") @map("numero_ticket")
  titulo                VarChar(150)
  descripcion           String
  tipoIncidenciaId      Int                  @map("tipo_incidencia_id")
  clienteId             Int                  @map("cliente_id")
  agenteAsignadoId      Int?                 @map("agente_asignado_id")
  estado                VarChar(30)          @default("NUEVO")
  prioridad             VarChar(30)          @default("P4_BAJA")
  severidad             VarChar(30)?
  criticidad            VarChar(30)?
  impacto               VarChar(30)?
  urgencia              VarChar(30)?
  fechaCreacion         Timestamp?           @default(now()) @map("fecha_creacion")
  fechaActualizacion    Timestamp?           @default(now()) @map("fecha_actualizacion")
  fechaResolucion       Timestamp?           @map("fecha_resolucion")
  fechaLimiteResolucion Timestamp(6)?        @map("fecha_limite_resolucion")
  fechaLimiteRespuesta  Timestamp(6)?        @map("fecha_limite_respuesta")
  fechaPrimeraRespuesta Timestamp(6)?        @map("fecha_primera_respuesta")
  slaResolucionCumplido Boolean?             @map("sla_resolucion_cumplido")
  slaRespuestaCumplido  Boolean?             @map("sla_respuesta_cumplido")
  proyectoId            Int                  @map("proyecto_id")
  tipoAtencion          VarChar(30)          @default("OPERATIVO") @map("tipo_atencion")
  fechaCierre           Timestamp(6)?        @map("fecha_cierre")
  adjuntos              Adjuntos[]
  comentarios           Comentarios[]
  enlacesCompartidos    EnlacesCompartidos[]
  historialTickets      HistorialTickets[]
  solicitudesRecurso    SolicitudesRecurso?
  proyecto              Proyectos            @relation(fields: [proyectoId], references: [id], map: "fk3k7gntl8exxbqrf4qbqkq9tx6", index: false)
  agenteAsignado        Usuarios?            @relation(name: "fk_ticket_agente", fields: [agenteAsignadoId], references: [id], map: "fk_ticket_agente", index: false)
  cliente               Usuarios             @relation(name: "fk_ticket_cliente", fields: [clienteId], references: [id], map: "fk_ticket_cliente", index: false)
  tipoIncidencia        TiposIncidencia      @relation(fields: [tipoIncidenciaId], references: [id], map: "fk_ticket_tipo", index: false)

  @@check(expression: "((tipo_atencion)::text = ANY (ARRAY[('OPERATIVO'::character varying)::text, ('RECURSO_EXTERNO'::character varying)::text]))", map: "chk_ticket_tipo_atencion")
  @@map("tickets")
}

model Adjuntos {
  id            Int           @id(map: "adjuntos_pkey") @default(autoincrement())
  ticketId      Int           @map("ticket_id")
  nombreArchivo VarChar(255)  @map("nombre_archivo")
  rutaArchivo   VarChar(500)  @map("ruta_archivo")
  tipoArchivo   VarChar(100)? @map("tipo_archivo")
  tamanio       BigInt?
  fechaSubida   Timestamp     @default(now()) @map("fecha_subida")
  ticket        Tickets       @relation(fields: [ticketId], references: [id], onDelete: Cascade, map: "fk_adjuntos_ticket", index: false)

  @@map("adjuntos")
}

model AuditoriaConfiguracion {
  id                  Int           @id(map: "auditoria_configuracion_pkey") @default(autoincrement())
  crearTicketAnterior Boolean       @map("crear_ticket_anterior")
  crearTicketNuevo    Boolean       @map("crear_ticket_nuevo")
  fechaCambio         Timestamp(6)  @map("fecha_cambio")
  historialAnterior   Boolean       @map("historial_anterior")
  historialNuevo      Boolean       @map("historial_nuevo")
  reportesAnterior    Boolean       @map("reportes_anterior")
  reportesNuevo       Boolean       @map("reportes_nuevo")
  usuarioCorreo       VarChar(150)  @map("usuario_correo")
  usuarioId           Int?          @map("usuario_id")
  usuarioNombre       VarChar(200)  @map("usuario_nombre")
  varianteAnterior    VarChar(1)    @map("variante_anterior")
  varianteNueva       VarChar(1)    @map("variante_nueva")
  modulo              VarChar(100)?
  rol                 VarChar(50)?
  valorAnterior       VarChar(100)? @map("valor_anterior")
  valorNuevo          VarChar(100)? @map("valor_nuevo")

  @@map("auditoria_configuracion")
}

model CodigosRecuperacionPassword {
  id               Int          @id(map: "codigos_recuperacion_password_pkey") @default(autoincrement())
  codigo           VarChar(100)
  correo           VarChar(150)
  fechaCreacion    Timestamp(6) @map("fecha_creacion")
  fechaExpiracion  Timestamp(6) @map("fecha_expiracion")
  usado            Boolean
  intentosFallidos Int          @default(0) @map("intentos_fallidos")

  @@map("codigos_recuperacion_password")
}

model Comentarios {
  id             Int         @id(map: "comentarios_pkey") @default(autoincrement())
  ticketId       Int         @map("ticket_id")
  usuarioId      Int         @map("usuario_id")
  contenido      String
  tipoComentario VarChar(20) @map("tipo_comentario")
  fechaCreacion  Timestamp?  @default(now()) @map("fecha_creacion")
  ticket         Tickets     @relation(fields: [ticketId], references: [id], map: "fk_comentario_ticket", index: false)
  usuario        Usuarios    @relation(fields: [usuarioId], references: [id], map: "fk_comentario_usuario", index: false)

  @@map("comentarios")
}

