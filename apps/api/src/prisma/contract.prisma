  crearTicketActivo             Boolean    @map("crear_ticket_activo")
  historialActivo               Boolean    @map("historial_activo")
  reportesActivos               Boolean    @map("reportes_activos")
  varianteVisual                VarChar(1) @map("variante_visual")
  crearTicketCliente            Boolean    @default(true) @map("crear_ticket_cliente")
  crearTicketAgente             Boolean    @default(true) @map("crear_ticket_agente")
  crearTicketSupervisor         Boolean    @default(true) @map("crear_ticket_supervisor")
  crearTicketAdmin              Boolean    @default(true) @map("crear_ticket_admin")
  reportesCliente               Boolean    @default(true) @map("reportes_cliente")
  reportesAgente                Boolean    @default(true) @map("reportes_agente")
  reportesSupervisor            Boolean    @default(true) @map("reportes_supervisor")
  reportesAdmin                 Boolean    @default(true) @map("reportes_admin")
  historialCliente              Boolean    @default(true) @map("historial_cliente")
  historialAgente               Boolean    @default(true) @map("historial_agente")
  historialSupervisor           Boolean    @default(true) @map("historial_supervisor")
  historialAdmin                Boolean    @default(true) @map("historial_admin")
  solicitudesRecursosActivo     Boolean    @default(true) @map("solicitudes_recursos_activo")
  solicitudesRecursosCliente    Boolean    @default(true) @map("solicitudes_recursos_cliente")
  solicitudesRecursosAgente     Boolean    @default(true) @map("solicitudes_recursos_agente")
  solicitudesRecursosSupervisor Boolean    @default(true) @map("solicitudes_recursos_supervisor")
  solicitudesRecursosAdmin      Boolean    @default(true) @map("solicitudes_recursos_admin")

  @@map("configuracion_sistema")
}

model EnlacesCompartidos {
  id                 BigInt       @id(map: "enlaces_compartidos_pkey") @default(autoincrement())
  ticketId           Int          @map("ticket_id")
  creadoPor          Int          @map("creado_por")
  correoDestinatario VarChar(150) @map("correo_destinatario")
  token              VarChar(150) @unique(map: "enlaces_compartidos_token_key")
  puedeVer           Boolean      @default(true) @map("puede_ver")
  puedeComentar      Boolean      @default(false) @map("puede_comentar")
  puedeVerAdjuntos   Boolean      @default(false) @map("puede_ver_adjuntos")
  puedeSubirAdjuntos Boolean      @default(false) @map("puede_subir_adjuntos")
  puedeCambiarEstado Boolean      @default(false) @map("puede_cambiar_estado")
  fechaCreacion      Timestamp    @default(now()) @map("fecha_creacion")
  fechaExpiracion    Timestamp?   @map("fecha_expiracion")
  activo             Boolean      @default(true)
  usuarios           Usuarios     @relation(fields: [creadoPor], references: [id], map: "fk_enlace_creado_por", index: false)
  ticket             Tickets      @relation(fields: [ticketId], references: [id], onDelete: Cascade, map: "fk_enlace_ticket", index: false)

  @@map("enlaces_compartidos")
}

model HistorialTickets {
  id            Int         @id(map: "historial_tickets_pkey") @default(autoincrement())
  ticketId      Int         @map("ticket_id")
  usuarioId     Int?        @map("usuario_id")
  accion        VarChar(50)
  valorAnterior String?     @map("valor_anterior")
  valorNuevo    String?     @map("valor_nuevo")
  descripcion   String?
  fechaCreacion Timestamp?  @map("fecha_creacion")
  ticket        Tickets     @relation(fields: [ticketId], references: [id], map: "fk_historial_ticket", index: false)
  usuario       Usuarios?   @relation(fields: [usuarioId], references: [id], map: "fk_historial_usuario", index: false)

  @@map("historial_tickets")
}

model Roles {
  id           Int            @id(map: "roles_pkey") @default(autoincrement())
  nombre       VarChar(50)    @unique(map: "roles_nombre_key")
  descripcion  String?
  usuarioRoles UsuarioRoles[]

  @@map("roles")
}

model SolicitudesRecurso {
  id                           Int           @id(map: "solicitudes_recurso_pkey") @default(autoincrement())
  ticketId                     Int           @unique(map: "solicitudes_recurso_ticket_id_key") @map("ticket_id")
  categoria                    VarChar(80)
  recurso                      VarChar(150)
  cantidad                     Int           @default(1)
  proveedor                    VarChar(150)?
  estadoRecurso                VarChar(40)   @default("NUEVO") @map("estado_recurso")
  fechaSolicitudProveedor      Timestamp?    @map("fecha_solicitud_proveedor")
  fechaEstimadaEntrega         Timestamp?    @map("fecha_estimada_entrega")
  fechaRecepcion               Timestamp?    @map("fecha_recepcion")
  fechaEntregaCliente          Timestamp?    @map("fecha_entrega_cliente")
  observaciones                String?
  fechaCreacion                Timestamp     @default(now()) @map("fecha_creacion")
  fechaActualizacion           Timestamp?    @map("fecha_actualizacion")
  fechaNotificacionRetraso     Timestamp(6)? @map("fecha_notificacion_retraso")
  detalleRetraso               String?       @map("detalle_retraso")
  fechaEstimadaEntregaOriginal Timestamp(6)? @map("fecha_estimada_entrega_original")
  motivoRetraso                VarChar(100)? @map("motivo_retraso")
  ticket                       Tickets       @relation(fields: [ticketId], references: [id], onDelete: Cascade, map: "fk_solicitud_recurso_ticket")

  @@index([estadoRecurso], map: "idx_solicitudes_recurso_estado")
  @@check(expression: "(cantidad > 0)", map: "chk_solicitud_recurso_cantidad")
  @@check(expression: "((estado_recurso)::text = ANY (ARRAY[('NUEVO'::character varying)::text, ('EN_VALIDACION'::character varying)::text, ('SOLICITADO_PROVEEDOR'::character varying)::text, ('ESPERANDO_PROVEEDOR'::character varying)::text, ('RECIBIDO'::character varying)::text, ('ENTREGADO'::character varying)::text, ('CERRADO'::character varying)::text, ('CANCELADO'::character varying)::text]))", map: "chk_solicitud_recurso_estado")
  @@map("solicitudes_recurso")
}

model UsuarioProyectos {
  id              Int          @id(map: "usuario_proyectos_pkey") @default(autoincrement())
  estado          Boolean
  fechaAsignacion Timestamp(6) @map("fecha_asignacion")
  proyectoId      Int          @map("proyecto_id")
  usuarioId       Int          @map("usuario_id")
  usuario         Usuarios     @relation(fields: [usuarioId], references: [id], map: "fk9eeykog2xs15f8rbb6bo311so")
  proyecto        Proyectos    @relation(fields: [proyectoId], references: [id], map: "fkklkudv208vsvl500h2cxu5wq7")

  @@unique([usuarioId, proyectoId], map: "uk_usuario_proyecto")
  @@index([proyectoId], map: "idx_usuario_proyecto_proyecto")
  @@index([usuarioId], map: "idx_usuario_proyecto_usuario")
  @@map("usuario_proyectos")
}

model UsuarioRoles {
  id        Int      @id(map: "usuario_roles_pkey") @default(autoincrement())
  usuarioId Int      @map("usuario_id")
  rolId     Int      @map("rol_id")
  rol       Roles    @relation(fields: [rolId], references: [id], map: "fk_rol", index: false)
  usuario   Usuarios @relation(fields: [usuarioId], references: [id], map: "fk_usuario", index: false)

  @@unique([usuarioId, rolId], map: "uq_usuario_rol")
  @@map("usuario_roles")
}
